+    uint8_t reserved_1 : 2;
+  } ICM_20948_REG_BANK_SEL_t;
+
+#ifdef __cplusplus
+}
+#endif /* __cplusplus */
+
+#endif /* _ICM_20948_REGISTERS_H_ */
