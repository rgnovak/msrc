 board/project/cockpit/cockpit_task.c |  23 ++-
 board/project/cockpit/piloten.c      | 275 +++++++++++++++++++++++++++
 board/project/cockpit/piloten.h      |  26 +++
 4 files changed, 320 insertions(+), 5 deletions(-)
 create mode 100644 board/project/cockpit/piloten.c
 create mode 100644 board/project/cockpit/piloten.h

