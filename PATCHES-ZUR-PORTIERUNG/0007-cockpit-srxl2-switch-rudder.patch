diff --git a/board/project/cockpit/cockpit_channels.h b/board/project/cockpit/cockpit_channels.h
new file mode 100644
index 0000000..6e99bb1
--- /dev/null
+++ b/board/project/cockpit/cockpit_channels.h
@@ -0,0 +1,25 @@
+#ifndef COCKPIT_CHANNELS_H
+#define COCKPIT_CHANNELS_H
+
+/* SRXL2 channel assignment for the cockpit's RC inputs, numbered the
+ * same way the transmitter/receiver shows them (1-indexed) - just
+ * change these two lines if the switch or the rudder end up on a
+ * different channel on your transmitter, nothing else needs to
+ * know about it.
+ *
+ * COCKPIT_CH_SWITCH: the 3-position switch that used to be read
+ * over a dedicated PWM wire (pwm_input.cpp) - now read as an SRXL2
+ * channel instead, same toggle behavior (see cockpit_switch.h).
+ * Channel 5 per Ralph: free on the Rockstar since it has no
+ * retractable gear.
+ *
+ * COCKPIT_CH_RUDDER: fed into the pilot head's gaze servo as an
+ * extra look-bias (see piloten.h's pilotenSetRudder()). Channel 4
+ * matches Ralph's own channel convention on the ix14+SE/AR10360T+
+ * (K4 = Seitenruder, per the A320 setup) - not yet confirmed for
+ * the Rockstar specifically, so double-check once the transmitter
+ * is in front of you. */
+#define COCKPIT_CH_SWITCH 5
+#define COCKPIT_CH_RUDDER 4
+
+#endif /* COCKPIT_CHANNELS_H */
diff --git a/board/project/cockpit/cockpit_switch.c b/board/project/cockpit/cockpit_switch.c
new file mode 100644
index 0000000..589b9df
--- /dev/null
+++ b/board/project/cockpit/cockpit_switch.c
@@ -0,0 +1,70 @@
+#include "cockpit_switch.h"
+
+#include "cockpit_channels.h"
+#include "pico/time.h"
+#include "srxl2_channels.h"
+
+/* Same zone thresholds as the original pwm_input.cpp, in the
+ * microsecond-equivalent units srxl2_channel_to_us() returns
+ * (~988..2012us, center 1500us - the same convention a standard RC
+ * PWM pulse uses, which is exactly why pwm_input's thresholds carry
+ * over unchanged). */
+static const float LOW_ENTER = 1300.0f;   /* < 1300us  -> LOW */
+static const float LOW_EXIT = 1350.0f;    /* > 1350us  -> back toward CENTER */
+static const float HIGH_ENTER = 1700.0f;  /* > 1700us  -> HIGH */
+static const float HIGH_EXIT = 1650.0f;   /* < 1650us  -> back toward CENTER */
+
+/* No new SRXL2 Control frame for this long -> treat the link as
+ * lost and fall back to CENTER, same idea as pwm_input's 250ms PWM
+ * signal timeout (there measured between pulse edges, here between
+ * parsed frames). */
+static const uint32_t SIGNAL_TIMEOUT_MS = 250;
+
+static cockpit_switch_zone_t currentZone = COCKPIT_SWITCH_CENTER;
+static bool signalPresent = false;
+static bool haveSeenAnyFrame = false;
+static uint32_t lastFrameCountSeen = 0;
+static uint32_t lastFrameSeenMs = 0;
+
+void cockpitSwitchUpdate(void) {
+    srxl2_channels_t ch;
+    srxl2_channels_get(&ch);
+
+    uint32_t now = to_ms_since_boot(get_absolute_time());
+
+    if (ch.frame_count != lastFrameCountSeen) {
+        lastFrameCountSeen = ch.frame_count;
+        lastFrameSeenMs = now;
+        haveSeenAnyFrame = true;
+    }
+
+    bool channelKnown = (ch.mask & (1u << (COCKPIT_CH_SWITCH - 1))) != 0;
+    bool frameRecent = haveSeenAnyFrame && (now - lastFrameSeenMs) <= SIGNAL_TIMEOUT_MS;
+    signalPresent = frameRecent && channelKnown;
+
+    if (!signalPresent) {
+        currentZone = COCKPIT_SWITCH_CENTER;
+        return;
+    }
+
+    float us = srxl2_channel_to_us(ch.raw[COCKPIT_CH_SWITCH - 1]);
+
+    switch (currentZone) {
+        case COCKPIT_SWITCH_CENTER:
+            if (us < LOW_ENTER)
+                currentZone = COCKPIT_SWITCH_LOW;
+            else if (us > HIGH_ENTER)
+                currentZone = COCKPIT_SWITCH_HIGH;
+            break;
+        case COCKPIT_SWITCH_LOW:
+            if (us > LOW_EXIT) currentZone = COCKPIT_SWITCH_CENTER;
+            break;
+        case COCKPIT_SWITCH_HIGH:
+            if (us < HIGH_EXIT) currentZone = COCKPIT_SWITCH_CENTER;
+            break;
+    }
+}
+
+cockpit_switch_zone_t cockpitSwitchGetZone(void) { return currentZone; }
+
+bool cockpitSwitchSignalPresent(void) { return signalPresent; }
diff --git a/board/project/cockpit/cockpit_switch.h b/board/project/cockpit/cockpit_switch.h
new file mode 100644
index 0000000..0b72787
--- /dev/null
+++ b/board/project/cockpit/cockpit_switch.h
@@ -0,0 +1,32 @@
+#ifndef COCKPIT_SWITCH_H
+#define COCKPIT_SWITCH_H
+
+#include <stdbool.h>
+
+/* SRXL2 equivalent of RC-Cockpit's pwm_input.cpp. The original read
+ * a 3-position switch as a raw PWM pulse (1000/1500/2000us) on a
+ * dedicated GPIO; MSRC already decodes this same switch's value out
+ * of the SRXL2 stream as a channel (see srxl2_channels.h), so this
+ * module classifies that channel's value into the same three zones
+ * with the same hysteresis thresholds, just reading a decoded
+ * channel instead of measuring a pulse. Which channel is read is
+ * set once in cockpit_channels.h. */
+
+typedef enum {
+    COCKPIT_SWITCH_LOW,
+    COCKPIT_SWITCH_CENTER,
+    COCKPIT_SWITCH_HIGH,
+} cockpit_switch_zone_t;
+
+/* Call once per cockpit_task loop iteration. */
+void cockpitSwitchUpdate(void);
+
+cockpit_switch_zone_t cockpitSwitchGetZone(void);
+
+/* false when the switch channel hasn't shown up in a recent SRXL2
+ * frame (receiver unbound, transmitter off, link lost) - mirrors
+ * pwm_input's signal-timeout fallback, which the caller should treat
+ * the same way: fail safe (displays + head movement both on). */
+bool cockpitSwitchSignalPresent(void);
+
+#endif /* COCKPIT_SWITCH_H */
