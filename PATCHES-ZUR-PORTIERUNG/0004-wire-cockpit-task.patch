 )
diff --git a/board/project/cockpit/cockpit_task.c b/board/project/cockpit/cockpit_task.c
new file mode 100644
index 0000000..13bfd3a
--- /dev/null
+++ b/board/project/cockpit/cockpit_task.c
@@ -0,0 +1,85 @@
+#include "cockpit_task.h"
+
+#include <math.h>
+
+#include "bootscreen.h"
+#include "compat.h"
+#include "display.h"
+#include "map.h"
+#include "pfd.h"
+
+/* Owns both panels end to end: brings up the SPI driver and
+ * framebuffers, shows the boot splash once, then renders the PFD
+ * (CS1) and the moving map (CS2) in a loop.
+ *
+ * Nothing here reads real sensor or SRXL2 data yet - pitch/roll/
+ * heading are a gentle synthetic sweep, purely so the panels
+ * visibly come alive once this is flashed, standing in for the IMU
+ * and servo work that comes next. Airspeed/altitude/VSI reuse the
+ * same fixed demo values the original Arduino sketch used, and
+ * ownLat/ownLon (in map.c) never change yet either, so the map's
+ * breadcrumb track stays put - also matching the original demo. */
+
+void cockpit_task(void *parameters) {
+    (void)parameters;
+
+    cockpitDisplayBegin();
+
+    showGarminBootscreen();
+    cockpitDisplayPushBootscreen();
+    vTaskDelay(pdMS_TO_TICKS(4000));
+
+    float heading = 0.0f;
+
+    while (1) {
+        heading += 1.0f;
+        if (heading >= 360.0f) heading -= 360.0f;
+
+        float pitch = 15.0f * sinf(heading * DEG_TO_RAD);
+        float roll = 25.0f * sinf(2.0f * heading * DEG_TO_RAD);
+
+        int ihdg = (int)heading;
+        int bug = (ihdg + 45) % 360;
+        int course = (ihdg + 30) % 360;
+        int bearing = (ihdg + 90) % 360;
+        int spd = 140;
+        int alt = 6000;
+        int vsi = 0;
+
+        /* ---- PFD, pushed to CS1 ---- */
+        clearFB(COL_BLACK);
+        drawHorizon(pitch, roll);
+        drawPitchLadder(pitch, roll);
+        drawRollScale();
+        drawCoursePointer(ihdg, course);
+        drawBearingPointer(ihdg, bearing);
+        drawCDIScale();
+        drawCDI(course, bearing);
+        drawToFromText(course, bearing);
+        drawHeadingTape(ihdg, bug);
+        drawHeadingWindow(ihdg);
+        renderAirspeedTape(spd);
+        drawSpeedWindow(spd);
+        renderAltitudeTape(alt);
+        drawAltitudeWindow(alt);
+        drawVSI(vsi);
+        drawVSINumber();
+        drawAircraft();
+        cockpitDisplaySwapAndPush(COCKPIT_PIN_CS1);
+
+        /* ---- Moving map, pushed to CS2 ---- */
+        clearFB(COL_BLACK);
+        trackLat[trackHead] = ownLat;
+        trackLon[trackHead] = ownLon;
+        trackHead = (trackHead + 1) % TRACK_LEN;
+        if (trackHead == 0) trackFilled = true;
+
+        drawMapBackground();
+        drawMapTrack(ownLat, ownLon, ihdg);
+        drawMapHeadingArrow(ihdg);
+        drawMapAircraftChevron(ihdg);
+        cockpitDisplaySwapAndPush(COCKPIT_PIN_CS2);
+
+        vTaskDelay(pdMS_TO_TICKS(50));
+    }
+}
diff --git a/board/project/cockpit/cockpit_task.h b/board/project/cockpit/cockpit_task.h
new file mode 100644
index 0000000..d1f4706
--- /dev/null
+++ b/board/project/cockpit/cockpit_task.h
@@ -0,0 +1,10 @@
+#ifndef COCKPIT_TASK_H
+#define COCKPIT_TASK_H
+
+#include "common.h"
+
+/* FreeRTOS task that owns both cockpit panels (PFD on CS1, moving map
+ * on CS2). Started from main.c alongside srxl2_task. */
+void cockpit_task(void *parameters);
+
+#endif /* COCKPIT_TASK_H */
